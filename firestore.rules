rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128; }

    match /users/{userId} {
      allow get, create: if isOwner(userId);
      allow update: if isOwner(userId);

      match /logs/{id} { allow read, write: if isOwner(userId); }
      match /memories/{id} { allow read, write: if isOwner(userId); }
      match /tasks/{id} { allow read, write: if isOwner(userId); }
    }
  }
}
